#!/usr/bin/env bash
# Managed by Ansible (role: opentofu).
# Runs OpenTofu inside the container. You can also use it by hand over SSH:
#   sudo {{ opentofu_dir }}/tofu.sh plan
#   sudo {{ opentofu_dir }}/tofu.sh state list
set -euo pipefail
cd "$(dirname "$0")"

exec docker run --rm \
  --env-file .env \
  --volume "$PWD/workspace:/workspace" \
  --workdir /workspace \
  "{{ opentofu_image_name }}:{{ opentofu_version }}" "$@"
