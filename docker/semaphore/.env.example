# Copy to .env:  cp .env.example .env && chmod 600 .env

# Your Semaphore login (created on first start).
SEMAPHORE_ADMIN=admin
SEMAPHORE_ADMIN_NAME=Admin
SEMAPHORE_ADMIN_EMAIL=admin@localhost
SEMAPHORE_ADMIN_PASSWORD=

# Encrypts the SSH keys and secrets Semaphore stores. Generate once with:
#   head -c32 /dev/urandom | base64
# Keep a copy somewhere safe (e.g. a password manager). If you lose it,
# every saved key and secret has to be entered again.
SEMAPHORE_ACCESS_KEY_ENCRYPTION=
