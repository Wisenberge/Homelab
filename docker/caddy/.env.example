# Copy to .env:  cp .env.example .env
# Then fill these in. Caddy reads them in conf/Caddyfile as {$NAME}.

# This VM's LAN IP (used for the Proxmox HTTPS certificate).
HOST_LAN_IP=10.10.0.95

# Your brother's server Tailscale IP (100.x.y.z). Find it with:
#   docker exec tailscale tailscale status
JELLYFIN_TAILSCALE_IP=

# Your Proxmox host's IP.
PROXMOX_IP=

# Later, for the public domain: e.g. jellyfin.hisdomain.com
JELLYFIN_DOMAIN=
